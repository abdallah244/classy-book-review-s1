# =================================
# ⚙️ Classy Book - Environment Variables Example
# =================================
# انسخ هذا الملف إلى .env وقم بتعديل القيم

# 🌐 Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# 👑 Admin Seed (Auto Create/Update)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@classybook.com
ADMIN_PASSWORD=12345678

# 🗄️ MongoDB Atlas
# احصل على الرابط من: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/classy_book?retryWrites=true&w=majority

# 🔐 JWT Authentication
JWT_SECRET=your_super_secret_key_here_change_in_production
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRATION=30d

# 🔒 Bcrypt
BCRYPT_SALT_ROUNDS=10

# 📧 Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@classybook.com

# 💳 Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# 📁 File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DEST=./uploads

# 🔄 Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# 🌍 CORS
CORS_ORIGIN=http://localhost:4200

# 📊 Redis (للتخزين المؤقت السريع)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# ☁️ Cloudinary (لتخزين الصور والملفات)
# احصل على البيانات من: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=classy-book

# 🔌 Socket.io (للتواصل الفوري)
SOCKET_PORT=3001
SOCKET_CORS_ORIGIN=http://localhost:4200
